# ── Runtime ──
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Upstream anime API ──
UPSTREAM_BASE_URL=https://api.anixart.tv
UPSTREAM_USER_AGENT=okhttp/4.12.0
UPSTREAM_TIMEOUT_MS=15000

# ── Gateway lock ──
# When set, every /api/v1/* call (except the exempt public ones) must carry the
# key in header `X-Gateway-Key` (legacy `X-Proxy-Key` is also accepted).
GATEWAY_KEY=

# Perk granted to every profile (unix seconds). Default ~ year 2099.
PREMIUM_EXPIRES_AT=4070908800

# ── Admin diagnostics (optional) ──
# Separate from GATEWAY_KEY (which ships in the public frontend bundle).
# Unset = /admin/* routes 404. Set = require header `X-Admin-Key`.
ADMIN_KEY=

# ── Telegram admin bridge (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Persistent state (blocklist + login journal)
STATE_DIR=.state

# ── Abuse limits ──
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# ── Release enrichment ──
BRAND_LABEL=MiraiPlay
# Shikimori enrichment of /release/:id (set 0/false to disable)
RELEASE_ENRICH=true

# ── Image proxy ──
# On-the-fly resize (?w=) + WebP (by Accept) with disk cache. Set 0/false to disable.
IMG_OPTIMIZE=true

# OAuth-приложение Shikimori — нужно, чтобы отмечать просмотренное и оценки
# в списке пользователя там. Без этих ключей синхронизация просто выключена,
# чтение метаданных работает и так.
# Приложение регистрируется с redirect_uri = urn:ietf:wg:oauth:2.0:oob
# (Shikimori показывает код на экране, пользователь вставляет его в Настройках).
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
# Переопределение redirect_uri; по умолчанию используется oob.
SHIKIMORI_REDIRECT_URI=

# --- Хроника просмотров для MiraiTimeline ---
# Ключ read-only роута GET /api/v1/timeline/events (заголовок X-Timeline-Key).
# Пусто — принимается GATEWAY_KEY; если пусто и то и другое, роут отдаёт 404.
TIMELINE_KEY=
# Anixart-id владельца: в хронику попадают только его просмотры (шлюзом
# пользуются и друзья на своих аккаунтах). Пусто — пишутся все.
TIMELINE_USER_ID=
